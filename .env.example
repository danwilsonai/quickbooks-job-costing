# Copy this file to .env and fill it in. Never commit .env or share it.
# Keys come from your app at developer.intuit.com (Keys & credentials).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# sandbox = Intuit's practice company. production = your real books. Stay on sandbox until you've tested.
QBO_ENV=sandbox

# Must match a redirect URI on your Intuit app exactly.
QBO_REDIRECT_URI=http://localhost:8000/callback
